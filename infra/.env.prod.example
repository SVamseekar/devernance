# Production / staging environment for infra/docker-compose.prod.yml.
# Copy to /opt/aos/.env on the VM, fill every blank, then: chmod 600 .env
# Never commit the filled file. Keep a copy in the password manager.
# Generate secrets with: openssl rand -base64 48

# ---- image tag (main = latest build of main; a git SHA pins one build) ----
AOS_TAG=main

# ---- database ----
POSTGRES_DB=aos
POSTGRES_USER=aos
POSTGRES_PASSWORD=

# ---- API secrets (>= 32 characters each; the API refuses to start with defaults on the postgres profile) ----
AUDIT_CHAIN_SECRET=
OAUTH_STATE_SECRET=
EVAL_CALLBACK_SECRET=
JWT_KEY_ENCRYPTION_SECRET=

# ---- app ----
# Public dashboard origin, no trailing slash. Also the OAuth redirect base.
ASSURANCE_APP_BASE_URL=https://app.example.com
OAUTH_AUTO_PROVISION=true
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
EVIDENCE_EMBEDDING_PROVIDER=djl-sentence
ASSURANCE_DEMO_ENABLED=true

# ---- email: primary Resend SMTP, fallback OCI Email Delivery ----
ASSURANCE_EMAIL_FROM=Assurance OS <no-reply@example.com>
ASSURANCE_SMTP_PRIMARY_HOST=smtp.resend.com
ASSURANCE_SMTP_PRIMARY_PORT=587
ASSURANCE_SMTP_PRIMARY_USERNAME=resend
ASSURANCE_SMTP_PRIMARY_PASSWORD=
ASSURANCE_SMTP_FALLBACK_HOST=smtp.email.eu-frankfurt-1.oci.oraclecloud.com
ASSURANCE_SMTP_FALLBACK_PORT=587
ASSURANCE_SMTP_FALLBACK_USERNAME=
ASSURANCE_SMTP_FALLBACK_PASSWORD=

# ---- billing (Dodo Payments; test until live mode is approved) ----
DODO_BASE_URL=https://test.dodopayments.com
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_BUSINESS_ID=
DODO_PRODUCT_TEAM_MONTHLY=
DODO_PRODUCT_TEAM_YEARLY=
DODO_PRODUCT_BUSINESS_MONTHLY=
DODO_PRODUCT_BUSINESS_YEARLY=

# ---- object storage for uploaded files (Cloudflare R2, EU jurisdiction) ----
ASSURANCE_STORAGE_ENABLED=true
ASSURANCE_STORAGE_BUCKET=aos-evidence
ASSURANCE_STORAGE_REGION=auto
ASSURANCE_STORAGE_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
ASSURANCE_STORAGE_ACCESS_KEY_ID=
ASSURANCE_STORAGE_SECRET_ACCESS_KEY=

# ---- dashboard (runtime; NEXT_PUBLIC_* values are image build arguments, see .github/workflows/images.yml) ----
TURNSTILE_SECRET_KEY=
DISCORD_DEMO_WEBHOOK_URL=

# ---- edge ----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- backups ----
# age public key (age1...). The private key stays offline and in the password manager, never on the VM.
BACKUP_AGE_RECIPIENT=
BACKUP_R2_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
BACKUP_R2_BUCKET=aos-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# UptimeRobot heartbeat URL; pinged after each successful daily and weekly backup.
BACKUP_HEARTBEAT_URL=
